# Public base URL, used for metadata and the OpenRouter referer header.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional. With a key, meal planning is done by an LLM that reasons about the
# dish, the head count and the budget. Without one the app falls back to its
# built-in recipe knowledge base — every feature still works, and every
# suggestion is still mapped to real catalogue products either way.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-3.5-haiku
